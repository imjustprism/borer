# EditorConfig (https://editorconfig.org): one whitespace contract for every
# editor and tool. rustfmt, ruff and taplo read their own files; this covers
# everything else (docs, scripts, config).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
max_line_length = 100

[*.{md,markdown}]
# two trailing spaces are a hard line break in Markdown
trim_trailing_whitespace = false
max_line_length = 80

[*.{toml,yml,yaml,json}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[Makefile]
indent_style = tab
