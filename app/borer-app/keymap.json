[
  {
    "bindings": {
      "secondary-o": "borer::Open",
      "ctrl-k ctrl-o": null
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "secondary-o": "borer::Open",
      "ctrl-f": "borer::FocusFilter",
      "ctrl-shift-e": "borer::ToggleFunctions"
    }
  },
  {
    "context": "DecompileView > Editor",
    "bindings": {
      "f12": "borer::FollowLink",
      "enter": "borer::FollowLink",
      "tab": "borer::ToggleListing",
      "g": "borer::GoTo"
    }
  },
  {
    "context": "FunctionsPanel > Editor",
    "bindings": {
      "up": "menu::SelectPrevious",
      "down": "menu::SelectNext"
    }
  },
  {
    "context": "MenuBar",
    "bindings": {
      "left": "menu_bar::ActivateMenuLeft",
      "right": "menu_bar::ActivateMenuRight"
    }
  },
  {
    "context": "StartItem",
    "bindings": {
      "up": "menu::SelectPrevious",
      "down": "menu::SelectNext",
      "enter": "menu::Confirm"
    }
  }
]
