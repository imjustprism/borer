/target
# Brand sources: made and kept in borer-web. The README uses the copies in brand/.
/assets
# side build directories (CARGO_TARGET_DIR=target-live and friends)
/target*/

# local MCP registration (absolute path, machine-specific); the plugin's own
# .mcp.json under plugins/ is part of the plugin
/.mcp.json

# Debug builds dropped in the tree. A dev binary embeds this machine's
# source paths (C:\Users\...), so it does not belong in a public checkout.
/*.exe
/*.pdb
/*.dll
/corpus-ref.exe

# Target packs and example scripts. Local only: a pack names one engine or
# product, and this tree does not publish them.
/packs/

# Python bytecode from the helper scripts.
__pycache__/

# Per-user agent and editor state.
.claude/settings.local.json
CLAUDE.local.md
.cache/
.claude/worktrees/

# Tool caches.
.ruff_cache/
.delta/
